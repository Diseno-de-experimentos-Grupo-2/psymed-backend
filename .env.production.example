# Production values for Render (Environment tab) or local smoke-test against prod Neon.
# Copy to .env.production locally if needed — do not commit secrets.
#
# Neon production branch (pooler endpoint — use for Render / serverless):
#   postgresql://neondb_owner:***@ep-solitary-lab-adnf17ay-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

BACKEND_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://ep-solitary-lab-adnf17ay-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password

SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# Set to your Vercel frontend URL after deploy
CORS_ALLOWED_ORIGINS=https://psymed-frontend.vercel.app,https://*.vercel.app
