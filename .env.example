# Copy to .env and fill in your Neon credentials.
# Neon dashboard: Project → Connection details → JDBC (or copy host/user/password and build URL below).

BACKEND_PORT=8080

# Required — Neon Postgres (must include sslmode=require)
# Example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# Comma-separated CORS origins (use * for local dev)
CORS_ALLOWED_ORIGINS=*

# Docker Hub (optional — only for publishing the image)
DOCKERHUB_USER=psymed
IMAGE_TAG=latest
