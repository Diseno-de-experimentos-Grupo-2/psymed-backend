# Local development — copy to .env and fill in your Neon *development* branch credentials.
# Production (Render) uses the pooler endpoint — see .env.production.example and render.yaml.
#
# Neon dashboard: Connection details → JDBC (must include ?sslmode=require)

BACKEND_PORT=8080

# Development branch example (direct endpoint, not pooler):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-autumn-truth-adb86di8.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# Comma-separated CORS origins (* is fine for local dev)
CORS_ALLOWED_ORIGINS=*

# Docker Hub (optional — only for publishing the image)
DOCKERHUB_USER=psymed
IMAGE_TAG=latest
