# Copia a .env y ajusta valores antes de docker compose up
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=psymed
MYSQL_PORT=3307
BACKEND_PORT=8080
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# Docker Hub (para build/push de imagen)
DOCKERHUB_USER=tu_usuario_dockerhub
IMAGE_TAG=latest
